<Window x:Class="Lavender.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:converters="clr-namespace:Lavender.App.Converters"
        Title="Lavender"
        WindowState="Maximized"
        UseLayoutRounding="True"
        Height="760"
        Width="1280"
        MinHeight="560"
        MinWidth="960"
        Loaded="Window_Loaded"
        Background="#181818"
        Foreground="#CCCCCC"
        FontFamily="Bahnschrift">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save"
                        Executed="SaveFile_Executed"
                        CanExecute="SaveFile_CanExecute"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/>
    </Window.InputBindings>

    <Window.Resources>
        <converters:ExplorerIndentConverter x:Key="ExplorerIndentConverter"/>
        <SolidColorBrush x:Key="AppBackground" Color="#181818"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#101010"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#181818"/>
        <SolidColorBrush x:Key="EditorBackground" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="InputBackground" Color="#242424"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8F8F8F"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#D8D8D8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#9D7CD8"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#B39BE0"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#332A46"/>

        <Style x:Key="WorkspaceSplitter" TargetType="GridSplitter">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="KeyboardIncrement" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent"><Border Width="1" HorizontalAlignment="Center" Background="{TemplateBinding Background}"/></Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#343434"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#292929"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#7653B5"/>
            <Setter Property="BorderBrush" Value="#7653B5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#8664C2"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#8664C2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#68479F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SelectionBrush" Value="#7653B5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#4A4A4A"
                                CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#5C5C5C"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#6A6A6A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="{StaticResource SidebarBackground}"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Root"
                              Background="{TemplateBinding Background}"
                              Width="10">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseButton"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseButton"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="Root" Property="Width" Value="Auto"/>
                                <Setter TargetName="Root" Property="Height" Value="10"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                                <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Background" Value="{StaticResource SidebarBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Orientation="Horizontal"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Background="{StaticResource SidebarBackground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Height="20">
                            <Image Width="16"
                                   Height="16"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Source="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TreeViewItem}},
                                                    Path=Tag,
                                                    Converter={x:Static converters:HeaderToImageConverter.Instance}}">
                                <Image.Style>
                                    <Style TargetType="{x:Type Image}">
                                        <Style.Triggers>
                                            <Trigger Property="Source" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Margin" Value="0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,3,0"
                                       Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TreeViewItem}},
                                                            Path=Foreground}"
                                       Text="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <StackPanel>
                            <!-- Children stay full width; only each header's content is indented. -->
                            <Border x:Name="ExplorerRow" Background="Transparent" CornerRadius="4"
                                    Margin="2,0" Padding="2,0" ClipToBounds="True">
                                <Grid>
                                    <Grid.Margin>
                                        <MultiBinding Converter="{StaticResource ExplorerIndentConverter}">
                                            <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}"/>
                                            <Binding Path="Items[0].Tag" RelativeSource="{RelativeSource AncestorType={x:Type TreeView}}"/>
                                        </MultiBinding>
                                    </Grid.Margin>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Focusable="False" ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path x:Name="Arrow" Data="M 0 0 L 3 3 L 0 6" Stroke="#888888"
                                                          StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                                            <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger SourceName="ExplorerRow" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExplorerRow" Property="Background" Value="#141414"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ExplorerRow" Property="Background" Value="#0D0D0D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackground}">
    <Grid x:Name="WorkspaceContent" Visibility="Collapsed"
          Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- Compact application menu -->
        <Border Grid.Row="0"
                Background="#181818"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="22"
                        Height="22"
                        Background="#303033"
                        BorderBrush="#414145"
                        BorderThickness="1"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                    <Image Width="16"
                           Height="16"
                           Source="/src/Lavender.App/Assets/Images/lavender_icon_small.png"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="File" Margin="0,0,18,0" Foreground="#BEBEBE" FontSize="12"/>
                    <TextBlock Text="Edit" Margin="0,0,18,0" Foreground="#BEBEBE" FontSize="12"/>
                    <TextBlock Text="View" Margin="0,0,18,0" Foreground="#BEBEBE" FontSize="12"/>
                    <TextBlock Text="Help" Foreground="#BEBEBE" FontSize="12"/>
                </StackPanel>

                <TextBlock Grid.Column="0" Grid.ColumnSpan="4" IsHitTestVisible="False"
                           Text="Lavender"
                           Foreground="#909090"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>


            </Grid>
        </Border>

        <Grid x:Name="WorkspacePanels" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="140"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="1.3*" MinWidth="346"/>
            </Grid.ColumnDefinitions>

            <!-- Project conversations -->
            <Grid Grid.Column="0" Background="{StaticResource SidebarBackground}" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="8,10,8,12">
                    <Button x:Name="NewChatButton" Style="{StaticResource SidebarAction}" Click="NewChat_Click"
                            ToolTip="Start a chat in the current project" AutomationProperties.Name="New chat">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" Stroke="#D8D2E4" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 20,11 V 18 Q 20,20 18,20 H 6 L 2,23 V 6 Q 2,4 4,4 H 12 M 18,1 V 9 M 14,5 H 22"/>
                            <TextBlock Text="New chat" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenProjectButton" Style="{StaticResource SidebarAction}" Click="OpenProject_Click"
                            Margin="0,4,0,0" AutomationProperties.Name="Open project">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" Stroke="#D8D2E4" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 2,17 V 5 Q 2,3 4,3 H 9 L 12,6 H 19 Q 21,6 21,8 V 9 M 2,17 L 5,10 H 23 L 20,19 Q 19.7,20 18,20 H 4 Q 2,20 2,17 Z"/>
                            <TextBlock x:Name="OpenProjectLabel" Text="Open project" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ListBox x:Name="ConversationPicker" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         Margin="6,0" Foreground="White" SelectionChanged="ConversationPicker_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch" ToolTip="Previous chats for the current project">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Border x:Name="HistoryBackground" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                              CanContentScroll="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="8,7"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#DEDEDE"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ChatRow" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChatRow" Property="Background" Value="#262626"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ChatRow" Property="Background" Value="#303030"/></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChatRow" Property="Background" Value="#303030"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="12" ToolTip="{Binding Title}"/>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="ClearHistoryButton" Grid.Row="2" Content="Clear project chats" Click="ClearHistory_Click"
                        Style="{StaticResource SidebarAction}" Margin="8" FontSize="11"
                        ToolTip="Delete saved chats for the currently open project"/>
            </Grid>

            <Grid Grid.Column="4" x:Name="CodeWorkspace" SizeChanged="CodeWorkspace_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ExplorerColumn" Width="180" MinWidth="120"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition x:Name="CodeEditorColumn" Width="*" MinWidth="220"/>
                </Grid.ColumnDefinitions>
            <!-- Explorer -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="8,0,8,0">
                        <TextBlock Text="EXPLORER"
                                   Foreground="#BBBBBB"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TreeView x:Name="FolderView"
                              Grid.Row="2"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False"
                              ClipToBounds="True"
                              SelectedItemChanged="FolderView_SelectedItemChanged"
                              PreviewMouseMove="FolderView_PreviewMouseMove">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0D0D0D"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0D0D0D"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E8E0F3"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#CFC7DC"/>
                            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DarkScrollViewerStyle}"/>
                        </TreeView.Resources>
                    </TreeView>

                </Grid>
            </Border>

            <!-- Editor -->
            <Grid Grid.Column="2" Background="{StaticResource EditorBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#181818"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <ListBox x:Name="OpenFileTabs" Background="Transparent" BorderThickness="0" Padding="0"
                             MaxHeight="108" HorizontalContentAlignment="Stretch"
                             SelectionChanged="OpenFileTabs_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="7,4"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="MaxWidth" Value="160"/>
                                <Setter Property="Foreground" Value="#AFAFAF"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template"><Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                                BorderThickness="0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#252525"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#101010"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid ToolTip="{Binding FullPath}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Source="{Binding FullPath, Converter={x:Static converters:HeaderToImageConverter.Instance}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Header}" FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <editor:TextEditor x:Name="FilePreviewBox"
                                   Grid.Row="1"
                                   Background="{StaticResource EditorBackground}"
                                   Foreground="#D4D4D4"
                                   BorderThickness="0"
                                   Padding="8,9"
                                   FontFamily="Cascadia Mono"
                                   FontSize="11"
                                   ShowLineNumbers="True"
                                   LineNumbersForeground="#858585"
                                   WordWrap="False"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto"/>
                <Grid x:Name="ImagePreviewPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Margin="16" ClipToBounds="True">
                        <Border.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#252525" Geometry="M0,0 H20 V20 H0 Z"/>
                                        <GeometryDrawing Brush="#303030" Geometry="M0,0 H10 V10 H0 Z M10,10 H20 V20 H10 Z"/>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                        <Image x:Name="AssetPreviewImage" Stretch="Uniform" StretchDirection="DownOnly"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="8"/>
                    </Border>
                    <TextBlock x:Name="ImagePreviewStatus" Grid.Row="1" Margin="16,0,16,14"
                               Foreground="#BBBBBB" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </Grid>
                <Border x:Name="EditorLoadingOverlay" Grid.Row="1"
                        Background="{StaticResource EditorBackground}"
                        Visibility="Collapsed">
                    <TextBlock Text=""
                               Foreground="#A6ADC8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Row="2" Background="#181818" Padding="10,8" BorderBrush="#303030" BorderThickness="0,1,0,0">
                    <DockPanel Height="140">
                        <TextBlock DockPanel.Dock="Top" Text="Problems" Foreground="#D4D4D4" FontWeight="SemiBold" Margin="4,0,4,5"/>
                        <TextBlock x:Name="ProblemsStatus" DockPanel.Dock="Top" Text="Select a C# file"
                                   Foreground="#999999" Margin="4" TextWrapping="Wrap"/>
                        <ListBox x:Name="ProblemsList" Background="#181818" Foreground="#DDDDDD"
                                 BorderThickness="0" DisplayMemberPath="Display" MouseDoubleClick="ProblemsList_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Border>
            </Grid>

                <GridSplitter Grid.Column="1" Style="{StaticResource WorkspaceSplitter}"
                              ToolTip="Resize explorer and code" AutomationProperties.Name="Resize explorer and code"/>
            </Grid>

            <!-- Assistant -->
            <Grid Grid.Column="2"
                  Background="{StaticResource PanelBackground}"
                  AllowDrop="True"
                  DragOver="ChatPanel_DragOver"
                  Drop="ChatPanel_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="1" Margin="0,8,0,6">
                            <TextBlock x:Name="AgentStatusText" Text="Starting…" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="ChatScrollViewer"
                              Grid.Row="1"
                              Padding="14"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChatMessagesPanel">
                        <TextBlock Text="Ask about the open project or drag files here for context."
                                   Foreground="#777777"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="2,4,18,16"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Margin="10,4,10,12" CornerRadius="22"
                        Background="#303030" BorderBrush="#414141"
                        BorderThickness="1" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel x:Name="ContextFilesRow" Grid.Row="1" Margin="0,4,0,8" Visibility="Collapsed">
                        <Button DockPanel.Dock="Right" Content="Clear files" Padding="4,0" Background="Transparent" BorderThickness="0" FontSize="10" Click="ClearContext_Click"/>
                        <TextBlock x:Name="SelectedContextText"
                                   Text="Context: No file selected"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   Margin="0,0,4,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <Grid>
                            <TextBox x:Name="UserInputBox"
                                     MinHeight="58" MaxHeight="180"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#F0F0F0" CaretBrush="White" FontSize="14"
                                     Padding="2,4"
                                     Text=""
                                     AutomationProperties.Name="Message"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalContentAlignment="Top"
                                     PreviewKeyDown="UserInputBox_KeyDown"/>
                            <TextBlock Text="Ask Lavender anything…" Foreground="#A6A6A6"
                                       FontSize="14" Margin="2,4" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=UserInputBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AttachFilesButton" Width="30" Height="32"
                                    Padding="0" Background="Transparent" BorderThickness="0"
                                    ToolTip="Add project files" AutomationProperties.Name="Add project files"
                                    Click="AttachFiles_Click">
                                <Path Data="M 2,8 L 14,8 M 8,2 L 8,14" Width="14" Height="14"
                                      Stretch="Uniform" Stroke="#E8E8E8" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,10,0">
                                <Button x:Name="ModelPicker" Background="Transparent" BorderThickness="0" Padding="8,6"
                                        Click="ModelPicker_Click" ToolTip="Choose the model for your next message"
                                        AutomationProperties.Name="Chat model">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="ModelPickerLabel" Foreground="#F0F0F0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ModelPickerReasoningLabel" Foreground="#A0A0A0"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        <Path Data="M 2,4 L 6,8 L 10,4" Width="9" Height="9"
                                              Margin="7,0,0,0" Stretch="Uniform" Stroke="#AAAAAA"
                                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="ModelMenuPopup" PlacementTarget="{Binding ElementName=ModelPicker}"
                                       Placement="Top" AllowsTransparency="True" StaysOpen="False"
                                       PopupAnimation="Fade" Closed="ModelMenuPopup_Closed">
                                    <Border Background="#303030" BorderBrush="#505050" BorderThickness="1"
                                            CornerRadius="10" Padding="8" MinWidth="230">
                                        <Grid>
                                            <StackPanel x:Name="ModelMenu">
                                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Hidden"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel x:Name="ModelListPanel"/>
                                                </ScrollViewer>
                                            </StackPanel>
                                            <StackPanel x:Name="ReasoningMenu" Visibility="Collapsed">
                                                <Button Content="‹  Models" Background="Transparent" BorderThickness="0"
                                                        HorizontalContentAlignment="Left" Click="ReasoningBack_Click"/>
                                                <Separator Background="#505050" Margin="2,5,2,8"/>
                                                <StackPanel x:Name="ReasoningListPanel"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Button x:Name="SendButton"
                                    Grid.Column="2" Width="34" Height="34" Padding="0"
                                    Background="{StaticResource AccentBrush}" Foreground="White"
                                    ToolTip="Send message (Enter)" AutomationProperties.Name="Send message"
                                    Click="SendButton_Click">
                                <Path Data="M 2,12 L 10,4 L 18,12 M 10,4 L 10,20"
                                      Width="15" Height="15" Stretch="Uniform" Stroke="White"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="SendCircle" Background="{TemplateBinding Background}" CornerRadius="17">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SendCircle" Property="Background" Value="{StaticResource AccentHoverBrush}"/></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="1" Style="{StaticResource WorkspaceSplitter}"
                          ToolTip="Drag to resize chat history and chat"
                          AutomationProperties.Name="Resize chat history and chat"/>
            <Thumb Grid.Column="3" Cursor="SizeWE" Focusable="True"
                   DragDelta="AgentEditorSplitter_DragDelta"
                   KeyDown="AgentEditorSplitter_KeyDown"
                   ToolTip="Drag to resize agent and code editor"
                   AutomationProperties.Name="Resize agent and code editor">
                <Thumb.Style>
                    <Style TargetType="Thumb">
                        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Grid Background="Transparent"><Border Width="1" HorizontalAlignment="Center" Background="{TemplateBinding Background}"/></Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Thumb.Style>
            </Thumb>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="#7653B5"
                Padding="8,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◇" Foreground="White" FontSize="11" Margin="0,0,7,0"/>
                    <TextBlock Text="Lavender" Foreground="White" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="UTF-8" Foreground="#F1EAFB" FontSize="10" Margin="0,0,14,0"/>
                    <TextBlock Text="C#" Foreground="#F1EAFB" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
        <Grid x:Name="StartupOverlay" Background="{StaticResource AppBackground}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="48" Height="48" Margin="0,0,0,24"
                      AutomationProperties.Name="Starting Lavender">
                    <Ellipse Stroke="#332A46" StrokeThickness="4" Margin="4"/>
                    <Path Data="M 24,4 A 20,20 0 0 1 44,24"
                          Stroke="{StaticResource AccentBrush}" StrokeThickness="4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform/>
                        </Path.RenderTransform>
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <Trigger Property="IsVisible" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard x:Name="StartupSpin">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:1"
                                                                     RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="StartupSpin"/>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
                <TextBlock Text="Lavender" FontSize="26" HorizontalAlignment="Center"
                           Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                <TextBlock x:Name="StartupStatusText" Text="Restoring your project…"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>



