<Window x:Class="Lavender.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Lavender.App.Converters"
        Title="Lavender"
        Height="760"
        Width="1280"
        MinHeight="560"
        MinWidth="960"
        Loaded="Window_Loaded"
        Background="#181818"
        Foreground="#CCCCCC"
        FontFamily="Bahnschrift">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#181818"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#181818"/>
        <SolidColorBrush x:Key="EditorBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="InputBackground" Color="#242424"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8F8F8F"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#D8D8D8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#9D7CD8"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#B39BE0"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#332A46"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#343434"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#292929"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#7653B5"/>
            <Setter Property="BorderBrush" Value="#7653B5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#8664C2"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#8664C2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#68479F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SelectionBrush" Value="#7653B5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#4A4A4A"
                                CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#5C5C5C"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#6A6A6A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="{StaticResource SidebarBackground}"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Root"
                              Background="{TemplateBinding Background}"
                              Width="10">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseButton"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseButton"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="Root" Property="Width" Value="Auto"/>
                                <Setter TargetName="Root" Property="Height" Value="10"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                                <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Background" Value="{StaticResource SidebarBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Orientation="Horizontal"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Background="{StaticResource SidebarBackground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Height="24">
                            <Image Width="16"
                                   Height="16"
                                   Margin="2,0,6,0"
                                   VerticalAlignment="Center"
                                   Source="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TreeViewItem}},
                                                    Path=Tag,
                                                    Converter={x:Static converters:HeaderToImageConverter.Instance}}">
                                <Image.Style>
                                    <Style TargetType="{x:Type Image}">
                                        <Style.Triggers>
                                            <Trigger Property="Source" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Margin" Value="0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TreeViewItem}},
                                                            Path=Foreground}"
                                       Text="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#292929"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- Compact application menu -->
        <Border Grid.Row="0"
                Background="#181818"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="22"
                        Height="22"
                        Background="#303033"
                        BorderBrush="#414145"
                        BorderThickness="1"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                    <Image Width="16"
                           Height="16"
                           Source="/src/Lavender.App/Assets/Images/lavender_icon_small.png"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock Text="File" Margin="0,0,18,0" Foreground="#BEBEBE" FontSize="12"/>
                    <TextBlock Text="Edit" Margin="0,0,18,0" Foreground="#BEBEBE" FontSize="12"/>
                    <TextBlock Text="View" Margin="0,0,18,0" Foreground="#BEBEBE" FontSize="12"/>
                    <TextBlock Text="Help" Foreground="#BEBEBE" FontSize="12"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="Lavender"
                           Foreground="#909090"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Text="Code workspace"
                           Foreground="#6F6F6F"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Explorer -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,0,10,0">
                        <TextBlock Text="EXPLORER"
                                   Foreground="#BBBBBB"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="•••"
                                   Foreground="#8C8C8C"
                                   FontSize="13"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Button x:Name="OpenProjectButton"
                            Grid.Row="1"
                            Style="{StaticResource AccentButton}"
                            Content="Open Folder"
                            Height="30"
                            Margin="12,2,12,10"
                            Click="OpenProject_Click"/>

                    <TreeView x:Name="FolderView"
                              Grid.Row="2"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4,0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              SelectedItemChanged="FolderView_SelectedItemChanged"
                              PreviewMouseMove="FolderView_PreviewMouseMove">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#332A46"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#292433"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E8E0F3"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#CFC7DC"/>
                            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DarkScrollViewerStyle}"/>
                        </TreeView.Resources>
                    </TreeView>

                    <Border Grid.Row="3"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Button Content="⚙  Settings"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Left"
                                Margin="4,4"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Editor -->
            <Grid Grid.Column="1" Background="{StaticResource EditorBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#181818"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Border Width="220"
                            HorizontalAlignment="Left"
                            Background="{StaticResource EditorBackground}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,0">
                        <Grid>
                            <TextBlock x:Name="PreviewFileNameText"
                                       Text="No file selected"
                                       Foreground="#D4D4D4"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="×"
                                       Foreground="#8C8C8C"
                                       FontSize="15"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#1C1C1C"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,1,0">
                        <TextBlock Text="1"
                                   Foreground="#5F5F5F"
                                   FontFamily="Cascadia Mono"
                                   FontSize="13"
                                   Margin="0,12,9,0"
                                   HorizontalAlignment="Right"/>
                    </Border>

                    <RichTextBox x:Name="FilePreviewBox"
                                 Grid.Column="1"
                                 Background="{StaticResource EditorBackground}"
                                 Foreground="#D4D4D4"
                                 BorderThickness="0"
                                 Padding="14,9"
                                 FontFamily="Cascadia Mono"
                                 FontSize="13"
                                 IsReadOnly="False"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 SelectionBrush="#5A437A"
                                 TextChanged="FilePreviewBox_TextChanged"/>
                </Grid>
            </Grid>

            <!-- Assistant -->
            <Grid Grid.Column="2"
                  Background="{StaticResource PanelBackground}"
                  AllowDrop="True"
                  DragOver="ChatPanel_DragOver"
                  Drop="ChatPanel_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="96"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,0,0,1"
                        Padding="14,0">
                    <Grid>
                        <TextBlock Text="ASSISTANT"
                                   Foreground="#BBBBBB"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="＋"
                                   Foreground="#9D7CD8"
                                   FontSize="16"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="ChatScrollViewer"
                              Grid.Row="1"
                              Padding="14"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChatMessagesPanel">
                        <TextBlock Text="Ask about the open project or drag files here for context."
                                   Foreground="#777777"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="2,4,18,16"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,1,0,0"
                        Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="SelectedContextText"
                                   Text="Context: No file selected"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   Margin="2,0,0,7"
                                   TextTrimming="CharacterEllipsis"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="58"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="UserInputBox"
                                     Grid.Column="0"
                                     MinHeight="34"
                                     MaxHeight="72"
                                     Padding="10,6"
                                     Text=""
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalContentAlignment="Top"
                                     KeyDown="UserInputBox_KeyDown"/>

                            <Button x:Name="SendButton"
                                    Grid.Column="1"
                                    Style="{StaticResource AccentButton}"
                                    Content="Send"
                                    Margin="7,0,0,0"
                                    Click="SendButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="#7653B5"
                Padding="8,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◇" Foreground="White" FontSize="11" Margin="0,0,7,0"/>
                    <TextBlock Text="Lavender" Foreground="White" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="UTF-8" Foreground="#F1EAFB" FontSize="10" Margin="0,0,14,0"/>
                    <TextBlock Text="C#" Foreground="#F1EAFB" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
