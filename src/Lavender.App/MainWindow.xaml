<Window x:Class="Lavender.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:converters="clr-namespace:Lavender.App.Converters"
        Title="Lavender"
        WindowState="Maximized"
        UseLayoutRounding="True"
        Height="760"
        Width="1280"
        MinHeight="560"
        MinWidth="960"
        Loaded="Window_Loaded"
        Background="#181818"
        Foreground="#CCCCCC"
        FontFamily="Bahnschrift">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save"
                        Executed="SaveFile_Executed"
                        CanExecute="SaveFile_CanExecute"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/>
    </Window.InputBindings>

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#181818"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#181818"/>
        <SolidColorBrush x:Key="EditorBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="InputBackground" Color="#242424"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8F8F8F"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#D8D8D8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#9D7CD8"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#B39BE0"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#332A46"/>

        <Style x:Key="WorkspaceSplitter" TargetType="GridSplitter">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="KeyboardIncrement" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#343434"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#292929"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#7653B5"/>
            <Setter Property="BorderBrush" Value="#7653B5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#8664C2"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#8664C2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#68479F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SelectionBrush" Value="#7653B5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#4A4A4A"
                                CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#5C5C5C"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#6A6A6A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="{StaticResource SidebarBackground}"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Root"
                              Background="{TemplateBinding Background}"
                              Width="10">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseButton"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseButton"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="Root" Property="Width" Value="Auto"/>
                                <Setter TargetName="Root" Property="Height" Value="10"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                                <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Background" Value="{StaticResource SidebarBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Orientation="Horizontal"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Background="{StaticResource SidebarBackground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Height="24">
                            <Image Width="16"
                                   Height="16"
                                   Margin="2,0,6,0"
                                   VerticalAlignment="Center"
                                   Source="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TreeViewItem}},
                                                    Path=Tag,
                                                    Converter={x:Static converters:HeaderToImageConverter.Instance}}">
                                <Image.Style>
                                    <Style TargetType="{x:Type Image}">
                                        <Style.Triggers>
                                            <Trigger Property="Source" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Margin" Value="0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TreeViewItem}},
                                                            Path=Foreground}"
                                       Text="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#292929"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackground}">
    <Grid x:Name="WorkspaceContent" Visibility="Collapsed"
          Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- Compact application menu -->
        <Border Grid.Row="0"
                Background="#181818"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="22"
                        Height="22"
                        Background="#303033"
                        BorderBrush="#414145"
                        BorderThickness="1"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                    <Image Width="16"
                           Height="16"
                           Source="/src/Lavender.App/Assets/Images/lavender_icon_small.png"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock Text="File" Margin="0,0,18,0" Foreground="#BEBEBE" FontSize="12"/>
                    <TextBlock Text="Edit" Margin="0,0,18,0" Foreground="#BEBEBE" FontSize="12"/>
                    <TextBlock Text="View" Margin="0,0,18,0" Foreground="#BEBEBE" FontSize="12"/>
                    <TextBlock Text="Help" Foreground="#BEBEBE" FontSize="12"/>
                    <Button Content="Save" Margin="16,0,0,0" Padding="10,2"
                            Command="ApplicationCommands.Save"
                            CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Save current file (Ctrl+S)"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="Lavender"
                           Foreground="#909090"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Text="Code workspace"
                           Foreground="#6F6F6F"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid x:Name="WorkspacePanels" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="160"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- Explorer -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,0,10,0">
                        <TextBlock Text="EXPLORER"
                                   Foreground="#BBBBBB"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="•••"
                                   Foreground="#8C8C8C"
                                   FontSize="13"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Button x:Name="OpenProjectButton"
                            Grid.Row="1"
                            Style="{StaticResource AccentButton}"
                            Content="Open Folder"
                            Height="30"
                            Margin="12,2,12,10"
                            Click="OpenProject_Click"/>

                    <TreeView x:Name="FolderView"
                              Grid.Row="2"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4,0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              SelectedItemChanged="FolderView_SelectedItemChanged"
                              PreviewMouseMove="FolderView_PreviewMouseMove">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#332A46"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#292433"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E8E0F3"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#CFC7DC"/>
                            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DarkScrollViewerStyle}"/>
                        </TreeView.Resources>
                    </TreeView>

                    <Border Grid.Row="3"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Button Content="⚙  Settings"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Left"
                                Margin="4,4"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Editor -->
            <Grid Grid.Column="4" Background="{StaticResource EditorBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#181818"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <ListBox x:Name="OpenFileTabs" Background="Transparent" BorderThickness="0"
                             SelectionChanged="OpenFileTabs_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate>
                            <TextBlock Text="{Binding Header}" ToolTip="{Binding FullPath}" Margin="10,5" Foreground="#D4D4D4"/>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <editor:TextEditor x:Name="FilePreviewBox"
                                   Grid.Row="1"
                                   Background="{StaticResource EditorBackground}"
                                   Foreground="#D4D4D4"
                                   BorderThickness="0"
                                   Padding="8,9"
                                   FontFamily="Cascadia Mono"
                                   FontSize="13"
                                   ShowLineNumbers="True"
                                   LineNumbersForeground="#858585"
                                   WordWrap="False"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto"/>
                <Border x:Name="EditorLoadingOverlay" Grid.Row="1"
                        Background="{StaticResource EditorBackground}"
                        Visibility="Collapsed">
                    <TextBlock Text=""
                               Foreground="#A6ADC8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Assistant -->
            <Grid Grid.Column="2"
                  Background="{StaticResource PanelBackground}"
                  AllowDrop="True"
                  DragOver="ChatPanel_DragOver"
                  Drop="ChatPanel_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,0,0,1"
                        Padding="14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,4">
                            <Button x:Name="NewChatButton" DockPanel.Dock="Right" Content="New chat" Click="NewChat_Click" Padding="6,3"/>
                            <ComboBox x:Name="ConversationPicker" DisplayMemberPath="Title" MinWidth="100"
                                      Margin="0,0,8,0" SelectionChanged="ConversationPicker_SelectionChanged"
                                      ToolTip="Saved conversations for the open project"/>
                        </DockPanel>
                        <DockPanel Grid.Row="1" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Timings" Padding="4,1" FontSize="10"
                                    Click="OpenTimings_Click" ToolTip="Open the indexing timing reports folder"/>
                            <Button x:Name="ClearHistoryButton" DockPanel.Dock="Right" Content="Dev: Clear history"
                                    Padding="4,1" FontSize="10" Click="ClearHistory_Click"
                                    ToolTip="Delete all saved chats and memory for the current project only"/>
                            <TextBlock x:Name="AgentStatusText" Text="Starting…" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Expander Grid.Row="2" Header="Agent activity" Margin="0,0,0,4"
                                  Foreground="#BBBBBB" IsExpanded="False">
                            <TextBox x:Name="AgentActivityLog" Height="170" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap" FontSize="11"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="Progress and tool outcomes, not private model reasoning"/>
                        </Expander>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="ChatScrollViewer"
                              Grid.Row="1"
                              Padding="14"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChatMessagesPanel">
                        <TextBlock Text="Ask about the open project or drag files here for context."
                                   Foreground="#777777"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="2,4,18,16"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Margin="10,4,10,12" CornerRadius="22"
                        Background="#303030" BorderBrush="#414141"
                        BorderThickness="1" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel x:Name="ContextFilesRow" Grid.Row="1" Margin="0,4,0,8" Visibility="Collapsed">
                        <Button DockPanel.Dock="Right" Content="Clear files" Padding="4,0" Background="Transparent" BorderThickness="0" FontSize="10" Click="ClearContext_Click"/>
                        <TextBlock x:Name="SelectedContextText"
                                   Text="Context: No file selected"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   Margin="2,0,6,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <Grid>
                            <TextBox x:Name="UserInputBox"
                                     MinHeight="58" MaxHeight="180"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#F0F0F0" CaretBrush="White" FontSize="14"
                                     Padding="2,4"
                                     Text=""
                                     AutomationProperties.Name="Message"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalContentAlignment="Top"
                                     PreviewKeyDown="UserInputBox_KeyDown"/>
                            <TextBlock Text="Ask Lavender anything…" Foreground="#A6A6A6"
                                       FontSize="14" Margin="2,4" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=UserInputBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AttachFilesButton" Width="30" Height="32"
                                    Padding="0" Background="Transparent" BorderThickness="0"
                                    ToolTip="Add project files" AutomationProperties.Name="Add project files"
                                    Click="AttachFiles_Click">
                                <Path Data="M 2,8 L 14,8 M 8,2 L 8,14" Width="14" Height="14"
                                      Stretch="Uniform" Stroke="#E8E8E8" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <ComboBox x:Name="ModelPicker" Grid.Column="1" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" Margin="4,0,10,0" MaxWidth="210"
                                      DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="ModelPicker_SelectionChanged"
                                      DropDownOpened="ModelPicker_DropDownOpened"
                                      Background="#303030" Foreground="#F0F0F0"
                                      AutomationProperties.Name="Chat model" ToolTip="Choose the model for your next message">
                                <ComboBox.Resources>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="#F0F0F0"/>
                                        <Setter Property="Background" Value="#303030"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBoxItem">
                                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#494052"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#49385E"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBox.Template>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0"
                                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="PickerBorder" Background="Transparent" CornerRadius="8" Padding="8,6">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="PickerBorder" Property="Background" Value="#414141"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                               VerticalAlignment="Center"/>
                                                    <Path Data="M 2,4 L 6,8 L 10,4" Width="9" Height="9"
                                                          Margin="7,0,0,0" Stretch="Uniform" Stroke="#AAAAAA"
                                                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ToggleButton>
                                            <Popup x:Name="PART_Popup" Placement="Top" AllowsTransparency="True" Focusable="False"
                                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                                <Border Background="#303030" BorderBrush="#505050" BorderThickness="1" CornerRadius="10" Padding="8" MinWidth="240">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <ScrollViewer MaxHeight="260"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                                        <StackPanel x:Name="ReasoningControl" Grid.Row="1" Margin="5,8,5,2" ToolTipService.ShowOnDisabled="True">
                                                            <Separator Background="#505050" Margin="0,0,0,8"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Reasoning" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                                                <Slider x:Name="ReasoningSlider" Grid.Column="1" Margin="8,0" Minimum="0" Maximum="4"
                                                                        TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                                                        SmallChange="1" LargeChange="1" IsMoveToPointEnabled="True" MinHeight="24"
                                                                        VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                                                                        AutomationProperties.Name="Reasoning effort" ToolTipService.ShowOnDisabled="True"
                                                                        ValueChanged="ReasoningSlider_ValueChanged"/>
                                                                <TextBlock x:Name="ReasoningValueText" Grid.Column="2" Text="Default" MinWidth="72"
                                                                           TextAlignment="Right" Foreground="#D8D8D8" FontSize="11" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Foreground" Value="#CBB4F3"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ComboBox.Template>
                            </ComboBox>
                            <Button x:Name="SendButton"
                                    Grid.Column="2" Width="34" Height="34" Padding="0"
                                    Background="{StaticResource AccentBrush}" Foreground="White"
                                    ToolTip="Send message (Enter)" AutomationProperties.Name="Send message"
                                    Click="SendButton_Click">
                                <Path Data="M 2,12 L 10,4 L 18,12 M 10,4 L 10,20"
                                      Width="15" Height="15" Stretch="Uniform" Stroke="White"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="SendCircle" Background="{TemplateBinding Background}" CornerRadius="17">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SendCircle" Property="Background" Value="{StaticResource AccentHoverBrush}"/></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="1" Style="{StaticResource WorkspaceSplitter}"
                          ToolTip="Drag to resize explorer and agent"
                          AutomationProperties.Name="Resize explorer and agent"/>
            <GridSplitter Grid.Column="3" Style="{StaticResource WorkspaceSplitter}"
                          ToolTip="Drag to resize agent and code editor"
                          AutomationProperties.Name="Resize agent and code editor"/>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="#7653B5"
                Padding="8,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◇" Foreground="White" FontSize="11" Margin="0,0,7,0"/>
                    <TextBlock Text="Lavender" Foreground="White" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="UTF-8" Foreground="#F1EAFB" FontSize="10" Margin="0,0,14,0"/>
                    <TextBlock Text="C#" Foreground="#F1EAFB" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
        <Grid x:Name="StartupOverlay" Background="{StaticResource AppBackground}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="48" Height="48" Margin="0,0,0,24"
                      AutomationProperties.Name="Starting Lavender">
                    <Ellipse Stroke="#332A46" StrokeThickness="4" Margin="4"/>
                    <Path Data="M 24,4 A 20,20 0 0 1 44,24"
                          Stroke="{StaticResource AccentBrush}" StrokeThickness="4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform/>
                        </Path.RenderTransform>
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <Trigger Property="IsVisible" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard x:Name="StartupSpin">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:1"
                                                                     RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="StartupSpin"/>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
                <TextBlock Text="Lavender" FontSize="26" HorizontalAlignment="Center"
                           Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                <TextBlock x:Name="StartupStatusText" Text="Restoring your project…"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>



